generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Game {
  id            String   @id @default(uuid())
  name          String
  coverImage    String
  tags          String   // JSON string for array
  comment       String?
  screenshots   String   // JSON string for array
  status        String   @default("playing") // playing, completed, dropped, wishlist
  rating        Int?
  playTime      Float?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}
